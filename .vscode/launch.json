{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI",
            "preLaunchTask": "kill-port-8000",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/backend",
            "args": [
                "src.api.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Python: Test Current File (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}/backend",
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Chrome: Frontend",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "preLaunchTask": "frontend: dev",
            "presentation": {
                "hidden": true
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (FastAPI + Frontend)",
            "configurations": [
                "Python: FastAPI",
                "Chrome: Frontend"
            ]
        }
    ]
}