{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-port-8000",
            "type": "shell",
            "command": "lsof -ti:8000 | xargs kill -9 || true",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "kill-port-5173",
            "type": "shell",
            "command": "lsof -ti:5173 | xargs kill -9 || true",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "frontend: dev",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "dependsOn": [
                "kill-port-5173"
            ],
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": "relative",
                "pattern": {
                    "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
                    "file": 1,
                    "location": 2,
                    "severity": 3,
                    "code": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE v.* ready in",
                    "endsPattern": "Local:.*http://localhost:5173"
                }
            },
            "presentation": {
                "reveal": "never",
                "group": "log"
            }
        }
    ]
}